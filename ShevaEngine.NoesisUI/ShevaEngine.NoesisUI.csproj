<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<AssemblyName>ShevaEngine.NoesisUI</AssemblyName>
		<RootNamespace>ShevaEngine.NoesisUI</RootNamespace>		
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>		
	</PropertyGroup>
	<ItemGroup>		
		<ProjectReference Include="..\ShevaEngine.Core\ShevaEngine.Core.csproj" />		
		<PackageReference Include="ManoxCZ.Noesis.MonoGame" Version="4.0.1" />		
		<PackageReference Include="MonoGame.Framework.Native" Version="3.8.6" />		
	</ItemGroup>
	<Target Name="IncludeMonoGameContentInProjectOutput" BeforeTargets="GetCopyToOutputDirectoryItems">
		<ItemGroup>
			<!-- Zachytí všechny zkompilované soubory ze složky Content ve výstupní složce knihovny -->
			<_ContentFilesToCopy Include="$(TargetDir)Content\**\*.*" />

			<!-- Označí je k přenesení do spustitelného projektu -->
			<ContentWithTargetPath Include="@(_ContentFilesToCopy)">
				<TargetPath>Content\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
				<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			</ContentWithTargetPath>
		</ItemGroup>
	</Target>
</Project>