<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>		
		<OutputType>Library</OutputType>
		<AssemblyName>ShevaEngine.Core</AssemblyName>
		<RootNamespace>ShevaEngine.Core</RootNamespace>		
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />		
		<PackageReference Include="System.Reactive" Version="7.0.0" />
		<PackageReference Include="MonoGame.Framework.Native" Version="3.8.6" />		
	</ItemGroup>
	<Import Project="..\ShevaEngine.Core.Content\BuildContent.targets" />
	<Target Name="IncludeMonoGameContentInProjectOutput" BeforeTargets="GetCopyToOutputDirectoryItems">
		<ItemGroup>
			<!-- Zachytí všechny zkompilované soubory ze složky Content ve výstupní složce knihovny -->
			<_ContentFilesToCopy Include="$(TargetDir)Content\**\*.*" />

			<!-- Označí je k přenesení do spustitelného projektu -->
			<ContentWithTargetPath Include="@(_ContentFilesToCopy)">
				<TargetPath>Content\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
				<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			</ContentWithTargetPath>
		</ItemGroup>
	</Target>
</Project>